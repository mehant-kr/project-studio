# Cloud sync for the desktop (and iPhone) app. Copy to .env.local and fill in from
# Supabase → Project Settings → API. The anon key is public by design; row-level
# security in supabase/migrations keeps each account's data private.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Development only: also run cloud sync in the browser dev server (npm run dev), for testing.
# VITE_CLOUD_IN_BROWSER=1
